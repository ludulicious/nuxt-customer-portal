{
  "name": "nuxt-customer-portal-monorepo",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:apex": "pnpm --filter @nuxt-customer-portal/demo-apex dev",
    "dev:brutal": "pnpm --filter @nuxt-customer-portal/demo-brutal dev",
    "dev:saas-portal": "pnpm --filter @nuxt-customer-portal/saas-portal dev",
    "dev:docs": "pnpm --filter @nuxt-customer-portal/docs dev",
    "format": "prettier --write . && eslint . --fix && prettier --write . && eslint .",
    "format:check": "prettier --check . && eslint .",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:packages && pnpm test:docs",
    "test:packages": "node --import tsx --test packages/*/test/*.test.ts",
    "test:docs": "pnpm --filter @nuxt-customer-portal/docs test:docs",
    "test:e2e:docs": "pnpm --filter @nuxt-customer-portal/docs test:e2e",
    "test:e2e:demos": "playwright test",
    "verify:docs-links": "pnpm --filter @nuxt-customer-portal/docs verify:public-links",
    "verify:saas-boundary": "node --import tsx scripts/verify-saas-boundary.ts",
    "pack:check": "node --import tsx scripts/verify-packages.ts",
    "pack:consumers": "node --import tsx scripts/verify-packages.ts --consumers",
    "pack:consumer:pnpm": "node --import tsx scripts/verify-packages.ts --consumers --manager=pnpm",
    "pack:consumer:npm": "node --import tsx scripts/verify-packages.ts --consumers --manager=npm",
    "pack:consumer:yarn": "node --import tsx scripts/verify-packages.ts --consumers --manager=yarn",
    "pack:consumer:bun": "node --import tsx scripts/verify-packages.ts --consumers --manager=bun",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "nuxt-site-config>h3": "1.15.4"
    }
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
