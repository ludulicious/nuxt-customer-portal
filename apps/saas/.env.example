DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://platform.localhost:3053
PUBLIC_URL=http://platform.localhost:3053
NUXT_PUBLIC_SITE_URL=http://platform.localhost:3053
ADMIN_EMAILS=

# Shared portal authentication email, including tenant verification and OTP.
# Tenant organization-specific business email remains configured in the portal.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Social login applies to the stable platform domain. Tenant portals initially
# use credentials only and may receive tenant-owned OAuth configuration later.
PORTAL_GITHUB_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PORTAL_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORTAL_REGISTRATION_MODE=open
PORTAL_TERMS_URL=/terms-of-service

SAAS_PLATFORM_HOST=platform.localhost
SAAS_PLATFORM_DOMAIN=platform.localhost
SAAS_SECRET_STORE_ENDPOINT=
SAAS_DATABASE_PROVIDER_ENDPOINT=
SAAS_PROVIDER_ADAPTER_TOKEN=
SAAS_TENANT_POOL_CACHE_MAX=25
