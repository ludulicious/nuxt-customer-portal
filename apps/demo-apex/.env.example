# Database
# Example (local): postgres://postgres:postgres@localhost:5432/customer_portal
DATABASE_URL=

# App URL used to build links in emails and auth redirects
# For local dev, this should match your Nuxt dev server (see `nuxt.config.ts` -> devServer.port)
PUBLIC_URL=http://localhost:3051

# Better Auth base URL (used by both server and client in this repo)
BETTER_AUTH_URL=http://localhost:3051

# Required secret for signing and encrypting authentication state (at least 32 characters)
BETTER_AUTH_SECRET=

# Optional: comma-separated list of emails that should be auto-assigned the admin role
# Example: admin@example.com,other-admin@example.com
ADMIN_EMAILS=
PORTAL_PROVIDER_NAME=
PORTAL_PROVIDER_SLUG=

# Platform authentication email (Resend). Organization transactional keys are configured in organization settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# This sender is used only for platform authentication messages.

# Optional: GitHub OAuth (only required if you want GitHub social login enabled)
PORTAL_GITHUB_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Google OAuth (only required if you want Google social login enabled)
PORTAL_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Registration policy: open, invitation-only, or disabled.
PORTAL_REGISTRATION_MODE=open
# Link used by the authentication forms for the Terms of Service.
PORTAL_TERMS_URL=/

# One-time migration for an existing legacy database. Set these only for the
# deployment that owns the existing database; completion is recorded in DB.
PORTAL_CLIENT_MIGRATION_PROVIDER=
PORTAL_CLIENT_MIGRATION_BACKUP_CONFIRMED=false
