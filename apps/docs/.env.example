# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Documentation collaboration links
NUXT_PUBLIC_DOCS_REPOSITORY_URL=https://github.com/ludulicious/portalnuxt
NUXT_PUBLIC_DOCS_REPOSITORY_BRANCH=master
NUXT_PUBLIC_DOCS_FEEDBACK_REPOSITORY_URL=https://github.com/ludulicious/portalnuxt

# Product source against which the rendered documentation was verified
NUXT_PUBLIC_PRODUCT_REPOSITORY_URL=https://github.com/ludulicious/customer-portal
NUXT_PUBLIC_PRODUCT_SOURCE_COMMIT=96bcf575a70f7943c357fc7dd817c02cadb1dee0
