{
  "name": "portalnuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:docs": "vitest run --project unit test/unit/docs-content.test.ts",
    "verify:public-links": "node scripts/verify-public-links.mjs",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/vscode-icons": "^1.2.68",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "^3.15.2",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "1.3.2",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/mcp-toolkit": "0.18.0",
    "@nuxtjs/mdc": "0.22.2",
    "@unhead/vue": "^3.2.3",
    "better-sqlite3": "^12.11.1",
    "h3": "2.0.1-rc.26",
    "nuxt": "^4.5.1",
    "nuxt-llms": "0.2.0",
    "nuxt-og-image": "^6.7.5",
    "satori": "^0.29.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "playwright-core": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "overrides": {
      "nuxt-site-config>h3": "1.15.4"
    }
  },
  "packageManager": "pnpm@10.26.1"
}
