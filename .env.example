# Set a release tag or immutable image digest that includes the source you deploy.
PORTAL_IMAGE=ghcr.io/ludulicious/nuxt-customer-portal:<release-version>
# Use URL-safe characters here because this password is also part of DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-unique-long-hex-secret
POSTGRES_DB=portal
PUBLIC_URL=http://localhost:3052
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters
PORTAL_ENCRYPTION_KEY=replace-with-a-unique-base64-encoded-32-byte-key
ADMIN_EMAILS=admin@example.com
PORTAL_PROVIDER_NAME=Customer Portal
PORTAL_PROVIDER_SLUG=portal
NUXT_PORTAL_DEMO_ENABLED=false
NUXT_PUBLIC_PORTAL_DEMO_ENABLED=false
