{
  "name": "@nuxt-customer-portal/kit",
  "version": "0.3.3",
  "license": "MIT",
  "homepage": "https://nuxt-customer-portal.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludulicious/nuxt-customer-portal.git"
  },
  "type": "module",
  "main": "./src/runtime.mjs",
  "types": "./src/runtime.d.ts",
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "bin",
    "src",
    "README.md",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./src/runtime.d.ts",
      "import": "./src/runtime.mjs"
    }
  },
  "bin": {
    "nuxt-customer-portal": "./bin/nuxt-customer-portal.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "jiti": "^2.6.1",
    "pg": "^8.22.0",
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  },
  "scripts": {
    "build:template": "node scripts/prepare-template.mjs",
    "prepack": "node scripts/prepare-template.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
